# DataVision — variables d'environnement (exemple)
#
# Copie ce fichier en `.env` à la racine du projet puis remplace les valeurs.
# `.env` est ignoré par git : les secrets ne partent jamais dans le dépôt.

# --- Django ---
DJANGO_SECRET_KEY=change-moi-avec-une-cle-secrete
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Connexion Google (django-allauth) ---
# Procédure pour obtenir ces deux valeurs : voir le README,
# section « Connexion Google ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Compte de démonstration (affiché sur la page de connexion) ---
DATAVISION_DEMO_LOGIN=True
DATAVISION_DEMO_USER=demo
DATAVISION_DEMO_PASSWORD=DataVision2026

# --- E-mails (mot de passe oublié) ---
# Sans EMAIL_HOST, les e-mails sont imprimés dans la console du serveur.
# En production :
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=mon-adresse@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=DataVision <no-reply@mon-domaine.com>
